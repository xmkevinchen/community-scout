{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://community-scout.local/schemas/community-lead.schema.json",
  "title": "CommunityLead",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "title",
    "summary",
    "repository_url",
    "community_url",
    "source_ref",
    "category",
    "published_at",
    "captured_at",
    "repository_mapping"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "repository_url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
    "community_url": { "type": "string", "format": "uri" },
    "source_ref": { "type": "string", "minLength": 1 },
    "category": { "type": "string" },
    "published_at": { "type": ["string", "null"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "repository_mapping": {
      "type": "string",
      "enum": ["explicit", "inferred", "missing"]
    }
  }
}
