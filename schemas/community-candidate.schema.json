{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://community-scout.local/schemas/community-candidate.schema.json",
  "title": "CommunityCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "repository_url",
    "title",
    "summary",
    "category",
    "mention_count",
    "mentions"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repository_url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "category": { "type": "string" },
    "mention_count": { "type": "integer", "minimum": 1 },
    "mentions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "community-lead.schema.json" }
    }
  }
}
